{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "repository": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^[a-z0-9][a-z0-9-]{0,38}\\/[a-z0-9_][a-z0-9_.-]{0,99}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "failingTarget": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "logs": {
      "minItems": 1,
      "maxItems": 80,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "attempts": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fixture"
            },
            "scenario": {
              "type": "string",
              "enum": [
                "frontend",
                "api-contract",
                "worker",
                "test",
                "configuration",
                "flaky",
                "unknown"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "application"
            },
            "service": {
              "type": "string",
              "enum": [
                "frontend",
                "api",
                "worker"
              ]
            }
          },
          "required": [
            "kind",
            "service"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "github-actions"
            },
            "runId": {
              "$ref": "#/$defs/__schema2"
            },
            "runAttempt": {
              "$ref": "#/$defs/__schema2"
            },
            "jobId": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": [
            "kind",
            "runId",
            "runAttempt",
            "jobId"
          ]
        }
      ]
    }
  },
  "required": [
    "version",
    "repository",
    "commit",
    "observedAt",
    "failingTarget",
    "logs",
    "source"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "maxLength": 1000
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "result": {
          "type": "string",
          "enum": [
            "failed",
            "passed"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "label",
        "result",
        "detail"
      ]
    },
    "__schema2": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  }
}
