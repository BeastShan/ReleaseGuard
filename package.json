{
  "name": "releaseguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "api": "node src/api/main.ts",
    "dashboard": "next dev dashboard --hostname 127.0.0.1",
    "build": "next build dashboard",
    "start:dashboard": "next start dashboard --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p dashboard/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "demo": "node lab/run.ts",
    "collect": "node src/collect/main.ts",
    "verify": "node scripts/verify.mjs",
    "schemas:check": "node scripts/schemas.mjs --check"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "next": "16.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
